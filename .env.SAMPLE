# Copy values from .env.SAMPLE and fill them in after setting up services
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOY_KEY=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=

# Emails allowed to open the admin UI, comma-separated. Server-only (never NEXT_PUBLIC_).
# Empty or missing = nobody is admitted.
ADMIN_ALLOWED_EMAILS=

# NOT read from this file: set these on the Convex deployment instead
#   npx convex env set WORKOS_CLIENT_ID <WORKOS_CLIENT_ID above>
#   npx convex env set ADMIN_WORKOS_USER_IDS <your WorkOS user id, user_...>   (empty = nobody can edit)

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=                  # team: mattheweblanke, project: blanke-portfolio
